/**
 * The RoomListItemView has the following structure:
 * button--------------------------------------------------|
 * | <-12px-> container------------------------------------|
 * |          | room avatar <-8px-> content----------------|
 * |          |                      | room_name <- 20px ->|
 * |          |                      | --------------------| <-- border
 * |-------------------------------------------------------|
 */

.mx_RoomListItemView {
    /* Remove button default style */
    background: transparent none repeat 0 0 / auto auto padding-box border-box scroll;
    background: initial;
    border: none;
    padding: 0;
    text-align: inherit;

    cursor: pointer;
    height: 48px;
    width: 100%;

    padding-left: var(--cpd-space-3x);
    font: var(--cpd-font-body-md-regular);
}

/*  Hide the menu by default  */

.mx_RoomListItemView .mx_RoomListItemView_menu {
        display: none;
    }

.mx_RoomListItemView:hover,
    .mx_RoomListItemView:focus-visible,
    .mx_RoomListItemView[data-state="open"],
    .mx_RoomListItemView:has(.mx_RoomListItemMenuView > button[data-state="open"]) {
        background-color: var(--cpd-color-bg-action-secondary-hovered);
    }

.mx_RoomListItemView:hover .mx_RoomListItemView_menu, .mx_RoomListItemView:focus-visible .mx_RoomListItemView_menu, .mx_RoomListItemView[data-state="open"] .mx_RoomListItemView_menu, .mx_RoomListItemView:has(.mx_RoomListItemMenuView > button[data-state="open"]) .mx_RoomListItemView_menu {
            display: -webkit-box;
            display: -ms-flexbox;
            display: flex;
        }

/**
             * The figma uses 16px padding (--cpd-space-4x) but due to https://github.com/element-hq/compound-web/issues/331
             * the icon size of the menu is 18px instead of 20px with a different internal padding
             * We need to use 18px to align the icon with the others icons
             * 18px is not available in compound spacing
             */

.mx_RoomListItemView:hover.mx_RoomListItemView_has_menu .mx_RoomListItemView_content, .mx_RoomListItemView:focus-visible.mx_RoomListItemView_has_menu .mx_RoomListItemView_content, .mx_RoomListItemView[data-state="open"].mx_RoomListItemView_has_menu .mx_RoomListItemView_content, .mx_RoomListItemView:has(.mx_RoomListItemMenuView > button[data-state="open"]).mx_RoomListItemView_has_menu .mx_RoomListItemView_content {
                padding-right: 18px;
            }

/*  When the menu is visible, hide the notification decoration to avoid clutter */

.mx_RoomListItemView:hover.mx_RoomListItemView_has_menu .mx_RoomListItemView_notificationDecoration, .mx_RoomListItemView:focus-visible.mx_RoomListItemView_has_menu .mx_RoomListItemView_notificationDecoration, .mx_RoomListItemView[data-state="open"].mx_RoomListItemView_has_menu .mx_RoomListItemView_notificationDecoration, .mx_RoomListItemView:has(.mx_RoomListItemMenuView > button[data-state="open"]).mx_RoomListItemView_has_menu .mx_RoomListItemView_notificationDecoration {
                display: none;
            }

