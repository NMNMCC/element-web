                -webkit-mask-position: center;
                        mask-position: center;
                background-color: var(--cpd-color-icon-on-solid-primary);
                width: 12px;
                height: 12px;
            }

.mx_PollOption_checked .mx_StyledRadioButton_checked input[type="radio"]:checked + div div {
                visibility: hidden;
            }

