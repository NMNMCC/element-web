        }

.mx_PollOption_checked .mx_StyledRadioButton_checked input[type="radio"]:checked + div::before {
                content: "";
                position: absolute;
                top: 50%;
                left: 50%;
                -webkit-transform: translate(-50%, -50%);
                        transform: translate(-50%, -50%);
                -webkit-mask-image: url("@vector-im/compound-design-tokens/icons/check.svg");
                        mask-image: url("@vector-im/compound-design-tokens/icons/check.svg");
                -webkit-mask-size: 12px 12px;
